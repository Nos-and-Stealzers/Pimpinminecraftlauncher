{
  "name": "pimpin-launcher",
  "productName": "Pimpin Launcher",
  "version": "0.1.0",
  "description": "A custom Minecraft launcher with a built-in mod, shader, resource pack and plugin library.",
  "main": "src/main/main.js",
  "author": "Nos and Stealzers",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "test": "node scripts/wardrobe-test.js && node --test scripts/world-backups.test.js scripts/screenshots.test.js scripts/appearance.test.js scripts/client-settings.test.js scripts/equipment-ores.test.js scripts/packs/inventory-coverage.test.js scripts/packs/ore-readability.test.js scripts/notifications.test.js scripts/notifications-main.test.js scripts/content-pins.test.js && node scripts/test-instance-lock.js",
    "test:electron-backups": "node scripts/test-backup-worker-electron.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "packs": "node scripts/build-packs.js"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.9",
    "msmc": "^5.0.5",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "homepage": "https://github.com/nos-and-stealzers/pimpinminecraftlauncher",
  "build": {
    "appId": "com.nosandstealzers.pimpinlauncher",
    "productName": "Pimpin Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "artifactName": "PimpinLauncher-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "PimpinLauncher-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "PimpinLauncher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "Nos and Stealzers",
      "synopsis": "Custom Minecraft launcher with mods, shaders and plugins",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nos-and-Stealzers",
        "repo": "pimpin-launcher-releases",
        "releaseType": "release"
      }
    ]
  },
  "desktopName": "pimpin-launcher.desktop"
}
